{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/hook-verifica-dependencia.mjs\"",
            "timeout": 10,
            "statusMessage": "Checando se é dependência nova..."
          }
        ]
      }
    ]
  }
}
